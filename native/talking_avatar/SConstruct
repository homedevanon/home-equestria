#!/usr/bin/env python
# Mouth shapes from speech audio, 10 ms at a time (class TalkingAvatarAnalyzer, src/analyzer.h).
# The network and its audio features are Talking Avatar by InterviewFlowAI (MIT,
# LICENSE.talking-avatar); the C++ port and the worker class are from the breeze-tts-pny mod by
# nak (MIT, LICENSE.breeze-tts-pny), src/ unchanged. Model: world/characters/lip_sync_model/.
# Build: native/talking_avatar/build.sh [linux|windows|android ...]
import os

godot_cpp = os.environ.get("GODOT_CPP", os.path.expanduser("~/tools/godot-cpp"))
env = SConscript(os.path.join(godot_cpp, "SConstruct"))
# Shipped binaries must not carry this machine's paths (assert/__FILE__ strings from headers).
# This flag goes on the shared environment: it also compiles godot-cpp's own objects, which every
# extension here links (2026-11-10: a build without it put home paths into libgodot-cpp).
env.Append(CCFLAGS=["-ffile-prefix-map=" + os.path.expanduser("~") + "/=~/"])
# Everything below is for this library only, so godot-cpp stays as the other extensions build it.
env = env.Clone()
env.Append(CPPPATH=["src/", "thirdparty/"])
# The port reports bad input by exception (caught inside the worker) and must add and multiply
# in the same order as the JavaScript original: no fused multiply-add, no fast-math.
env.Append(CXXFLAGS=["-fexceptions"])
env.Append(CCFLAGS=["-ffp-contract=off"])
if env["platform"] in ("linux", "android"):
    env.Append(LINKFLAGS=["-Wl,-Bsymbolic", "-Wl,--exclude-libs,ALL"])
if env["platform"] == "linux":
    env.Append(LIBS=["pthread"])
library = env.SharedLibrary(
    "bin/libtalking_avatar{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=Glob("src/*.cpp"),
)
Default(library)
