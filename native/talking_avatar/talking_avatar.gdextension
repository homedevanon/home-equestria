[configuration]

entry_symbol = "talking_avatar_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://native/talking_avatar/bin/libtalking_avatar.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/talking_avatar/bin/libtalking_avatar.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://native/talking_avatar/bin/libtalking_avatar.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/talking_avatar/bin/libtalking_avatar.windows.template_release.x86_64.dll"
android.release.arm64 = "res://native/talking_avatar/bin/libtalking_avatar.android.template_release.arm64.so"
android.debug.arm64 = "res://native/talking_avatar/bin/libtalking_avatar.android.template_release.arm64.so"
