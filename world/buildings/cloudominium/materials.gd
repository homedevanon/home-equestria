extends RefCounted
## Rainbow Dash's Cloudominium surfaces (dev 2026-09-28): one cached material per contract name.
## Painted walls, floors and ceilings read SVG art in the shared room frame (room_surface), so it
## continues across every piece whatever its UVs. Furniture paint maps in each mesh's own space
## (object_art, cloud, amp_face) so BoxMesh UV atlases do not split it.
## References: art/references/cloudominium-2026-09-28/. The SVGs are generated by
## archive/cloudominium-2026-09-28/surfaces/generate_surfaces.py (authored vectors).
const LAYOUT := preload("res://world/buildings/cloudominium/layout.gd")
const IMAGE := preload("res://world/resource_image.gd")
const ROOM := preload("res://world/buildings/cloudominium/room_surface.gdshader")
const OBJECT_ART := preload("res://world/buildings/cloudominium/object_art.gdshader")
const CLOUD := preload("res://world/buildings/cloudominium/cloud.gdshader")
const AMP := preload("res://world/buildings/cloudominium/amp_face.gdshader")
const ROOT := "res://world/buildings/cloudominium/art/"
## Painted room surfaces and their artwork.
const PAINTED := {
	"wall": "wall_ground.svg",
	"wall_upper": "wall_upper.svg",
	"floor_ground": "floor_ground.svg",
	"floor_upper": "floor_upper.svg",
	"ceiling": "ceiling.svg",
}
## Floor and ceiling artwork spans this many tower radii (9.5 m at the default 4.2 m radius);
## the upper floor's checkered path starts at the default stair landing.
const PLAN_PER_RADIUS := 9.5 / 4.2
static var _materials: Dictionary = {}
static var _textures: Dictionary = {}
static var _world_to_room := Transform3D.IDENTITY
static var _room_bound := false
static var _layout: Dictionary = {}

## Binds the painted surfaces to the room: call with SHELL.prepare()'s frame and layout before
## Architecture.build. Painted materials made earlier are updated in place. Until then they
## treat each mesh's own space as the room frame (right for meshes built in room coordinates).
static func set_room(frame: Transform3D, layout: Dictionary) -> void:
	_world_to_room = frame.affine_inverse()
	_room_bound = true
	_layout = layout
	for painted: String in PAINTED:
		if _materials.has(painted):
			_paint(_materials[painted] as ShaderMaterial, painted)

## The floating home moved (cloud_drift.gd): painted surfaces read the room frame in world space.
static func move_room(frame: Transform3D) -> void:
	_world_to_room = frame.affine_inverse()
	for painted: String in PAINTED:
		if _materials.has(painted):
			(_materials[painted] as ShaderMaterial).set_shader_parameter("world_to_room", _world_to_room)

## The shared material for a contract name; unknown names get a pale default (also cached).
static func get_material(name: String) -> Material:
	if _materials.has(name):
		return _materials[name] as Material
	var result: Material = _make(name)
	_materials[name] = result
	return result

static func _make(name: String) -> Material:
	if PAINTED.has(name):
		var painted := ShaderMaterial.new()
		painted.shader = ROOM
		painted.set_shader_parameter("artwork", _texture(str(PAINTED[name])))
		_paint(painted, name)
		return painted
	match name:
		"cloud":
			return _cloud(Color("fbfdff"), Color("cde5f6"), Color("a3d0ee"))
		"cloud_fabric":
			# Lounge sofa: lavender puffs with pale lavender swirl lines on the arms.
			return _cloud(Color("aca8e6"), Color("8983cf"), Color("dedafb"))
		"column":
			return _plain(Color("d3ebf4"), 0.45, 0.4)
		"iron":
			return _plain(Color("16171c"), 0.28, 0.55)
		"glass":
			var glass := _plain(Color(0.74, 0.9, 1.0, 0.24), 0.06, 0.7)
			glass.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
			glass.cull_mode = BaseMaterial3D.CULL_DISABLED
			return glass
		"brass":
			var brass := _plain(Color("d6aa45"), 0.38, 0.6)
			brass.metallic = 0.35
			return brass
		"gold_wood":
			return _plain(Color("e5c060"), 0.55, 0.45)
		"door_purple":
			return _art("door_swirls.svg", Color("6d61ad"), Vector2(0.9, 1.125), 0.7, 0.3)
		"fabric_lightning":
			return _art("fabric_bolts.svg", Color("7b66bf"), Vector2(0.5, 0.5), 0.92, 0.2)
		"rug":
			return _art("rug_swirls.svg", Color("2f5f79"), Vector2(2.0, 2.0), 0.98, 0.1)
		"quilt":
			# One rainbow bolt centred on the quilt mesh's origin, on its upward faces.
			var quilt := _art("quilt_bolt.svg", Color("293f92"), Vector2(1.2, 1.5), 0.93, 0.2)
			quilt.set_shader_parameter("art_mode", 1)
			return quilt
		"guitar":
			var guitar := ShaderMaterial.new()
			guitar.shader = OBJECT_ART
			guitar.set_shader_parameter("art_mode", 2)
			guitar.set_shader_parameter("band_width", 0.06)
			guitar.set_shader_parameter("roughness_value", 0.35)
			guitar.set_shader_parameter("specular_value", 0.6)
			return guitar
		"amp":
			var amp := ShaderMaterial.new()
			amp.shader = AMP
			return amp
		"pillow":
			return _fabric(Color("8d78d4"), 0.25)
		"red_velvet":
			return _fabric(Color("b83a36"), 0.4)
		"pink_blanket":
			return _fabric(Color("f3a5c9"), 0.25)
		"poster_wonderbolts":
			return _picture("poster_wonderbolts.svg", 0.8)
		"banner_celestia":
			return _picture("banner_celestia.svg", 0.95)
		"statue":
			return _plain(Color("50545e"), 0.72, 0.35)
		"stone":
			return _plain(Color("c5c9cc"), 0.9, 0.25)
		"book":
			# MultiMesh instance colours (or vertex colours) tint individual covers.
			var book := _plain(Color("6b4fa8"), 0.85, 0.25)
			book.vertex_color_use_as_albedo = true
			return book
	push_warning("Cloudominium material '%s' is not in the contract; using the pale default." % name)
	return _plain(Color("dde8f2"), 0.9, 0.2)

static func _paint(material: ShaderMaterial, name: String) -> void:
	var room: Dictionary = _layout if not _layout.is_empty() else LAYOUT.defaults()
	var radius := float(room.get("radius", 4.2))
	material.set_shader_parameter("world_to_room", _world_to_room)
	material.set_shader_parameter("room_bound", _room_bound)
	material.set_shader_parameter("wall_radius", radius)
	if not name.begins_with("wall"):
		material.set_shader_parameter("surface_kind", 1)
		material.set_shader_parameter("plan_size", radius * PLAN_PER_RADIUS)
		return
	var upper := name == "wall_upper"
	var bottom := float(room.get("upper_y", 4.8)) if upper else float(room.get("ground_y", 0.0))
	var top := float(room.get("ceiling_y", 9.6)) if upper else float(room.get("ground_ceiling_y", 4.55))
	var height := maxf(top - bottom, 1.0)
	material.set_shader_parameter("surface_kind", 0)
	material.set_shader_parameter("base_y", bottom)
	material.set_shader_parameter("band_height", height)
	# About one square of artwork per storey height; whole repeats keep the wrap seamless.
	material.set_shader_parameter("repeats", maxf(3.0, roundf(TAU * radius / height)))
	var zones: Dictionary = room.get("zones", {})
	var lounge: Dictionary = zones.get("lounge", {})
	if upper or lounge.is_empty():
		material.set_shader_parameter("rainbow_strength", 0.0)
		return
	# "a rainbow painted across the upper wall" (lounge reference): one arc over the lounge,
	# apex under the ceiling, dropping 1.4 m towards the zone's ends where it fades out.
	var start_angle := float(lounge.get("from", 35.0))
	var end_angle := float(lounge.get("to", 125.0))
	var span := deg_to_rad(absf(end_angle - start_angle) * 0.5) * radius
	var drop := 1.4
	var outer := (span * span + drop * drop) / (2.0 * drop)
	material.set_shader_parameter("rainbow", Vector4(deg_to_rad((start_angle + end_angle) * 0.5), span, height - 0.3 - outer, outer))
	material.set_shader_parameter("rainbow_strength", 0.8)

static func _plain(colour: Color, roughness: float, specular: float) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = colour
	material.roughness = roughness
	material.metallic_specular = specular
	return material

## Soft cloth: rim light reads as velvet/fleece; double-sided for thin drapes.
static func _fabric(colour: Color, rim: float) -> StandardMaterial3D:
	var material := _plain(colour, 0.95, 0.2)
	material.rim_enabled = true
	material.rim = rim
	material.rim_tint = 0.5
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	return material

## Pictures map 0..1 over the face: QuadMesh/PlaneMesh or a mesh with its own 0..1 UVs.
static func _picture(filename: String, roughness: float) -> StandardMaterial3D:
	var material := _plain(Color.WHITE, roughness, 0.25)
	material.albedo_texture = _texture(filename)
	material.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	return material

static func _art(filename: String, base: Color, size: Vector2, roughness: float, specular: float) -> ShaderMaterial:
	var material := ShaderMaterial.new()
	material.shader = OBJECT_ART
	material.set_shader_parameter("art", _texture(filename))
	material.set_shader_parameter("base_color", base)
	material.set_shader_parameter("art_size", size)
	material.set_shader_parameter("roughness_value", roughness)
	material.set_shader_parameter("specular_value", specular)
	return material

static func _cloud(base: Color, shade: Color, line: Color) -> ShaderMaterial:
	var material := ShaderMaterial.new()
	material.shader = CLOUD
	material.set_shader_parameter("swirls", _texture("cloud_swirls.svg"))
	material.set_shader_parameter("base_color", base)
	material.set_shader_parameter("shade_color", shade)
	material.set_shader_parameter("line_color", line)
	return material

## Artwork with mipmaps; source runs read the SVG itself, exports its imported texture.
static func _texture(filename: String) -> Texture2D:
	if _textures.has(filename):
		return _textures[filename] as Texture2D
	var image: Image = IMAGE.read(ROOT + filename)
	if image == null or image.is_empty():
		push_error("Cloudominium artwork could not load: " + filename)
		return null
	if image.detect_alpha() == Image.ALPHA_NONE:
		image.convert(Image.FORMAT_RGB8)
	else:
		# Transparent texels take their neighbours' colour so mipmaps do not darken edges.
		image.convert(Image.FORMAT_RGBA8)
		image.fix_alpha_edges()
	var texture := IMAGE.upload(image)
	_textures[filename] = texture
	return texture
