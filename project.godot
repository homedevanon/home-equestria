]
}

[physics]

common/max_physics_steps_per_frame=2
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=40960
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.35, 0.5, 0.7, 1)

[shader_globals]

season_leaf={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
season_ground={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
season_snow={
"type": "float",
"value": 0.0
}
season_flowers={
"type": "float",
"value": 1.0
}
interior_light={
"type": "color",
"value": Color(0.45, 0.57, 0.8, 1)
}
vegetation_color_map={
"type": "sampler2D",
"value": ""
}
vegetation_color_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 1)
}
vegetation_color_enabled={
"type": "bool",
"value": false
}
diffuse_curve={
"type": "sampler2D",
"value": "res://addons/cel-shader/diffuse-texture.tres"
}
fresnel_smoothness={
"type": "float",
"value": 0.05
}
specular_smoothness={
"type": "float",
"value": 0.05
}
outline_width={
"type": "float",
"value": 6.0
}
outline_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}
sky_time={
"type": "float",
"value": 0.0
}
sky_eye={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
sky_cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
sky_cloud_shape={
"type": "vec3",
"value": Vector3(0.45, 1, 0)
}

[xr]

openxr/startup_alert=false
shaders/enabled=true
openxr/enabled.android=true
openxr/foveation_level.android=0
openxr/foveation_dynamic.android=true
openxr/render_target_size_multiplier.android=1.0
