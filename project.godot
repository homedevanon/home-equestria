; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Home: Equestria"
config/description="Cozy VR life-sim in Equestria."
config/version="0.3.0-maredev"
run/main_scene="res://world/ui/title_screen.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="home-equestria-public"
config/project_settings_override="user://launch.cfg"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.png"

[audio]

driver/enable_input=true

[autoload]

XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"
Settings="*res://autoload/settings.gd"
Quality="*res://autoload/quality.gd"
TimeOfDay="*res://autoload/time_of_day.gd"
ZoneManager="*res://autoload/zone_manager.gd"
Mods="*res://world/modding/mods.gd"

[debug]

settings/crash_handler/message="Home: Equestria crashed. Please send the files in the logs folder (Linux: ~/.local/share/home-equestria-public/logs, Windows: %APPDATA%\\home-equestria-public\\logs) with your report, or make a support bundle from the pause menu."
file_logging/enable_file_logging=true
file_logging/max_log_files=10

[dev]

theme/custom_font="res://world/ui/fonts/CelestiaMediumRedux.ttf"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[input]

voice_talk={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":84,"key_label":0,"unicode":116,"location":0,"echo":false,"script":null)
]
}
move_forward={
